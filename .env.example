# ====================================================================
# SpillWatch AI - Environment Configuration Template
# Copy this file to .env and provide your actual credentials.
# ====================================================================

# 1. SUPABASE DATABASE & STORAGE
# Retrieve these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 2. ATTENTION U-NET SEGMENTATION MODEL
OIL_THRESHOLD=0.50
MODEL_WEIGHTS_PATH=models/oil_spill_attention_unet.pth
MODEL_METADATA_PATH=models/model_metadata.json

# 3. FASTAPI SERVER CONFIGURATION
PORT=8000
HOST=0.0.0.0
API_BASE_URL=http://localhost:8000
PUBLIC_API_BASE_URL=http://localhost:8000

# 4. AIS & ENVIRONMENTAL APIS (OPTIONAL)
# Live AIS WebSocket (get free key at https://aisstream.io)
AISSTREAM_API_KEY=

# Global MetOcean APIs (Open-Meteo requires no key)
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
