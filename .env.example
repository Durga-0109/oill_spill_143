# Backend-only configuration. Do not expose these values in the frontend or GitHub.
HOST=127.0.0.1
PORT=8000
API_KEY=replace_with_backend_api_key

# Model paths (auto-detected by default from handoff directories)
MODEL_CHECKPOINT_PATH=./binary classification-20260916T134200Z-1-001/binary classification/model_service_handoff/checkpoints/best_model.pth

# Database configuration (Defaults to local SQLite oil_spilling.db)
DATABASE_URL=sqlite:///./backend/oil_spilling.db
# PostgreSQL / Supabase connection (optional for cloud production):
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Live AIS Stream API (Optional: if empty, defaults to indexed MarineCadastre AccessAIS)
AISSTREAM_API_KEY=your_aisstream_api_key_here
ENABLE_MARINECADASTRE=true

# Live Weather & Oceanographic APIs
OPENWEATHER_API_KEY=your_openweather_api_key_here
COPERNICUS_USERNAME=your_copernicus_username
COPERNICUS_PASSWORD=your_copernicus_password

# Supabase backend configuration (Optional)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Region of Interest bounds (Arabian Sea / Lakshadweep corridor default)
AOI_MIN_LON=72.0
AOI_MIN_LAT=10.5
AOI_MAX_LON=73.5
AOI_MAX_LAT=12.5
